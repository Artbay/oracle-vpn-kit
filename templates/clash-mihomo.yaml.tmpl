# Clash Verge Rev / Mihomo 订阅模板（参考用）
# 实际订阅请用 tools/gen_subscription.py 生成：它会按 CF_PREFERRED_IPS 自动展开 ${NODE_PREFIX}-CDN-1..N 节点。
# 节点顺序建议：Hy2 → TUIC → CDN 优选 IP → CDN 域名 → XHTTP → Reality
mixed-port: 7890
allow-lan: false
mode: rule
log-level: info
ipv6: false
proxies:
- name: ${NODE_PREFIX}-Hy2
  type: hysteria2
  server: ${VPS_IP}
  port: ${HY2_PORT}
  ports: ${HY2_HOP_START}-${HY2_HOP_END}
  hop-interval: 30
  password: ${HY2_PASSWORD}
  sni: ${HY2_SNI}
  skip-cert-verify: true
  alpn: [h3]
  obfs: salamander
  obfs-password: ${HY2_OBFS_PASSWORD}
- name: ${NODE_PREFIX}-TUIC
  type: tuic
  server: ${VPS_IP}
  port: ${TUIC_PORT}
  uuid: ${TUIC_UUID}
  password: ${TUIC_PASSWORD}
  alpn: [h3]
  congestion-controller: bbr
  sni: ${HY2_SNI}
  skip-cert-verify: true
  udp-relay-mode: native
  reduce-rtt: true
- name: ${NODE_PREFIX}-CDN-1          # 优选 IP 节点示例：server 换成 CF 优选入口 IP，sni/Host 仍为域名
  type: vless
  server: ${CF_PREFERRED_IP_1}
  port: 443
  uuid: ${VLESS_UUID}
  network: ws
  tls: true
  udp: true
  servername: ${CDN_DOMAIN}
  client-fingerprint: chrome
  ws-opts:
    path: ${WS_PATH}
    headers:
      Host: ${CDN_DOMAIN}
- name: ${NODE_PREFIX}-CDN
  type: vless
  server: ${CDN_DOMAIN}
  port: 443
  uuid: ${VLESS_UUID}
  network: ws
  tls: true
  udp: true
  servername: ${CDN_DOMAIN}
  client-fingerprint: chrome
  ws-opts:
    path: ${WS_PATH}
    headers:
      Host: ${CDN_DOMAIN}
- name: ${NODE_PREFIX}-XHTTP
  type: vless
  server: ${VPS_IP}
  port: ${XHTTP_PORT}
  uuid: ${VLESS_UUID}
  network: xhttp
  tls: true
  udp: true
  servername: ${REALITY_SNI}
  client-fingerprint: chrome
  reality-opts:
    public-key: ${REALITY_PUBLIC_KEY}
    short-id: ${XHTTP_SHORT_ID}
  xhttp-opts:
    path: ${XHTTP_PATH}
    mode: auto
- name: ${NODE_PREFIX}-Reality
  type: vless
  server: ${VPS_IP}
  port: ${REALITY_PORT}
  uuid: ${VLESS_UUID}
  network: tcp
  tls: true
  udp: true
  flow: xtls-rprx-vision
  servername: ${REALITY_SNI}
  client-fingerprint: chrome
  reality-opts:
    public-key: ${REALITY_PUBLIC_KEY}
    short-id: ${REALITY_SHORT_ID}
proxy-groups:
- name: 节点选择
  type: select
  proxies:
  - ${NODE_PREFIX}-Hy2
  - ${NODE_PREFIX}-TUIC
  - ${NODE_PREFIX}-CDN-1
  - ${NODE_PREFIX}-CDN
  - ${NODE_PREFIX}-XHTTP
  - ${NODE_PREFIX}-Reality
  - DIRECT
rules:
- IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
- IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
- IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
- IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
- DOMAIN-SUFFIX,cn,DIRECT
- DOMAIN-SUFFIX,baidu.com,DIRECT
- DOMAIN-SUFFIX,qq.com,DIRECT
- DOMAIN-SUFFIX,taobao.com,DIRECT
- DOMAIN-SUFFIX,alipay.com,DIRECT
- DOMAIN-SUFFIX,bilibili.com,DIRECT
- MATCH,节点选择
