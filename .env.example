# 复制为 .env 后填写；.env 已在 .gitignore 中，切勿提交。
# 带 <...> 的是占位符。随机值（含端口）可用 scripts/gen_secrets.sh 生成，只填空值/占位符，不覆盖已有值。

# ---- 服务器 ----
VPS_IP=<VPS_IP>                 # 云服务器公网 IP（临时 IP 会变，换 IP 后重新生成订阅）
VPS_IFACE=<VPS_IFACE>           # 公网网卡名，用 `ip -br link` 查看（OCI 的 Ubuntu 镜像常见为 ens3）
NODE_PREFIX=MyVPN               # 客户端节点名前缀，例如 MyVPN-Hy2，可自定义

# ---- Xray: VLESS + Reality (TCP) ----
VLESS_UUID=                     # xray uuid
REALITY_PRIVATE_KEY=            # xray x25519 生成（仅服务器）
REALITY_PUBLIC_KEY=             # 与私钥配对（客户端用）
REALITY_SNI=<REALITY_SNI>       # 伪装目标站，需支持 TLS1.3 + H2，自行挑选
REALITY_PORT=<REALITY_PORT>     # 随机 TCP 端口（gen_secrets.sh 生成）
REALITY_SHORT_ID=               # openssl rand -hex 8
XHTTP_PORT=443                  # XHTTP+Reality 用的 TCP 端口，443 最常见，也可改
XHTTP_PATH=                     # /随机串
XHTTP_SHORT_ID=

# ---- Xray: VLESS + WS（仅 127.0.0.1，给 Cloudflare Tunnel） ----
WS_LOCAL_PORT=<WS_LOCAL_PORT>   # 随机本地端口（gen_secrets.sh 生成）
WS_PATH=                        # /随机串

# ---- Hysteria2 ----
HY2_PORT=<HY2_PORT>             # 随机 UDP 端口（gen_secrets.sh 生成）
HY2_PASSWORD=
HY2_OBFS_PASSWORD=
HY2_SNI=<HY2_SNI>               # 自签证书 CN / 客户端 sni / 伪装站点，自行挑选一个大型站点域名
HY2_HOP_START=<HY2_HOP_START>   # 端口跳跃区间起点（gen_secrets.sh 生成，区间长度 1000）
HY2_HOP_END=<HY2_HOP_END>

# ---- TUIC v5 ----
TUIC_PORT=<TUIC_PORT>           # 随机 UDP 端口，不能落在跳跃区间内（gen_secrets.sh 会避开）
TUIC_UUID=
TUIC_PASSWORD=

# ---- Cloudflare Tunnel（CDN 兜底） ----
CF_TUNNEL_NAME=<TUNNEL_NAME>    # 隧道名，自定义，例如 my-tunnel
CDN_DOMAIN=<CDN_DOMAIN>         # 你自己域名下的子域（托管在 Cloudflare），例如 cdn.example.com
# 可选：优选 Cloudflare 入口 IP（CloudflareST 测出），逗号分隔，如 <CF_IP_1>,<CF_IP_2>
CF_PREFERRED_IPS=

# ---- 订阅 ----
SUB_PORT=<SUB_PORT>             # 随机 TCP 端口（gen_secrets.sh 生成）
SUB_TOKEN=                      # openssl rand -hex 24，作为订阅 URL 的秘密路径
SUB_FILE_NAME=clash.yaml
SINGBOX_REALITY=                # 留空：sing-box.json 不含 Reality（上游 sing-box 与 Xray v26.9.8+ 不兼容）；已修复的分支可设 1

# ---- 版本与维护（可选，留空即用默认）----
XRAY_VERSION=                   # 首次安装的 Xray 版本，如 v26.1.1；留空 = 最新正式版
HY2_VERSION=                    # 首次安装的 Hysteria 版本，如 app/v2.6.0；留空 = 最新正式版
TUIC_VERSION=1.0.0              # tuic-server 版本
TUIC_SHA256=                    # 可选：钉死你核对过的 tuic-server sha256；留空则用官方 .sha256sum 校验
# BACKUP_DIR=/var/backups/oracle-vpn-kit   # update/uninstall/订阅的备份目录（默认值）
